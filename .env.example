MEQR_API_KEY=your_api_key_here

# Notion integration (for UTM Builder QR generation)
# Create at https://www.notion.so/my-integrations, then share the UTM Builder DB with it
NOTION_TOKEN=your_notion_integration_token_here

# UTM Builder database ID
UTM_DB_ID=your_utm_db_id_from_notion_here

# Webhook secret for Vercel serverless function (shared with Notion automation)
WEBHOOK_SECRET=your_webhook_secret_here
